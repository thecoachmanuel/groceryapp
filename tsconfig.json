{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "next/*": [
        "./pwa/node_modules/next/*"
      ],
      "lucide-react": [
        "./pwa/node_modules/lucide-react"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts",
    "pwa/src/types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "pwa",
    "**/__tests__/**"
  ]
}